{
  "name": "paneshell",
  "version": "1.0.0",
  "description": "Turn any website into a desktop app.",
  "main": "src/main/main.js",
  "author": "Abhijat <abhijat.tech@gmail.com>",
  "homepage": "https://github.com/Abhijat-Abhijat/paneshell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhijat-Abhijat/paneshell.git"
  },
  "bugs": {
    "url": "https://github.com/Abhijat-Abhijat/paneshell/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.abhijat.paneshell",
    "productName": "Paneshell",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "package.json"
    ],

    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Paneshell",
      "artifactName": "Paneshell-Setup-${version}.${ext}"
    },

    "linux": {
      "target": [{ "target": "deb", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Turn any website into a desktop app.",
      "artifactName": "paneshell_${version}_${arch}.${ext}"
    },
    "deb": {
      "depends": ["gconf2", "gconf-service", "libnotify4", "libappindicator1", "libxtst6", "libnss3"]
    },

    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Paneshell-${version}-${arch}.${ext}"
    }
  }
}
